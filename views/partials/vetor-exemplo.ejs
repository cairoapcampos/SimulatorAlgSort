<code>[<% vetor.valores.forEach((v, indice) => { %><%= indice ? (indice === vetor.separaEm ? ' | ' : ', ') : '' %><span class="<%= locals.gapGrupos ? `grupo-shell-${indice % gapGrupos}` : v.mudou ? 'valor-alterado' : '' %>"><% if (v.digitos) { %><% v.digitos.forEach((d) => { %><span class="<%= d.ativo ? 'valor-alterado' : '' %>"><%= d.texto %></span><% }) %><% } else { %><%= v.numero %><% } %></span><% }) %>]</code>
