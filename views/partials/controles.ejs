<div class="progresso" role="progressbar" aria-valuemin="0" aria-valuemax="100"><div id="progresso" class="progresso-preenchido"></div></div>

<div class="controles">
  <button id="inicio">⏮ Início <kbd>Home</kbd></button>
  <button id="anterior">◀ Anterior <kbd>←</kbd></button>
  <button id="play">▶ Play</button>
  <button id="proximo">Próximo ▶ <kbd>→</kbd></button>
  <button id="fim">Fim ⏭ <kbd>End</kbd></button>
  <button id="proxGap">Fim da passada ⏩ <kbd>P</kbd></button>
  <button id="reiniciar">↺ Reiniciar <kbd>R</kbd></button>
  <label>Velocidade
    <input id="velocidade" type="range" min="100" max="1500" step="100" value="700">
  </label>
</div>
